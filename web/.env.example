# Base URL of the Veilance party agent (agent/API.md). Leave unset to use the built-in mock.
VITE_API_URL=http://localhost:4000
# Force the mock adapter even when VITE_API_URL is set.
VITE_MOCK=
# Mock-only: simulated proving time (ms) for issue/transfer/attest jobs (default 3000).
VITE_MOCK_PROVE_MS=3000

# External explorer links (optional). Preprod:
# VITE_EXPLORER_TX_URL=https://preprod.midnightexplorer.com/transactions/0x{hash}
# VITE_EXPLORER_BLOCK_URL=https://preprod.midnightexplorer.com/blocks/{height}
# VITE_EXPLORER_CONTRACT_URL=https://preprod.midnightexplorer.com/contracts/{address}
